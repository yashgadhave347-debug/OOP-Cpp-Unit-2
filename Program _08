#include <iostream>

class Base {
public:
    Base() {
        std::cout << "Base constructor\n";       // Called first
    }

    ~Base() {
        std::cout << "Base destructor\n";        // Called last
    }
};

class Derived : public Base {
public:
    Derived() {
        std::cout << "Derived constructor\n";    // Called after Base constructor
    }

    ~Derived() {
        std::cout << "Derived destructor\n";     // Called first
    }
};

int main() {
    Derived object;                              // Create Derived object

    return 0;                                    // Object is destroyed here
}
