#include <iostream>
#include <string>
#include <utility>

// Base class
class Person {
protected:
    std::string name;

public:
    explicit Person(std::string personName)
        : name(std::move(personName)) {}

    void displayName() const {
        std::cout << "Name: " << name << '\n';
    }
};

// Virtual inheritance avoids duplicate Person objects
class Student : virtual public Person {
public:
    Student() : Person("Unknown") {}
};

// Virtual inheritance avoids ambiguity
class Employee : virtual public Person {
public:
    Employee() : Person("Unknown") {}
};

// TeachingAssistant inherits from both Student and Employee
class TeachingAssistant : public Student, public Employee {
public:
    // Most-derived class initializes the virtual base
    explicit TeachingAssistant(std::string assistantName)
        : Person(std::move(assistantName)), Student(), Employee() {}
};

int main() {
    // Create TeachingAssistant object
    TeachingAssistant assistant("Riya");

    // Display the name
    assistant.displayName();

    return 0;
}
