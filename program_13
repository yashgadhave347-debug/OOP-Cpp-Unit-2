#include <iostream>

// Account class
class Account {
private:
    double balance;

    // Auditor can access private members
    friend class Auditor;

public:
    // Constructor
    explicit Account(double initialBalance) : balance(initialBalance) {}
};

// Auditor class
class Auditor {
public:
    // Inspect account balance
    void inspect(const Account& account) const {
        std::cout << "Account Balance: " << account.balance << '\n';
    }
};

int main() {
    // Create Account and Auditor objects
    Account account(5000.0);
    Auditor auditor;

    // Display account balance using friend class
    auditor.inspect(account);

    return 0;
}
