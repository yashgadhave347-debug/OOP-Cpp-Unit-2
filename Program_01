#include <iostream>
#include <string>
#include <utility>

class Person {                 // Base class
protected:
    std::string name;

public:
    explicit Person(std::string personName)
        : name(std::move(personName)) {}

    void displayName() const {
        std::cout << "Name: " << name << '\n';
    }
};

class Student : public Person {    // Student inherits Person
private:
    int rollNumber;

public:
    // Calls Person constructor and initializes roll number
    Student(std::string studentName, int roll)
        : Person(std::move(studentName)), rollNumber(roll) {}

    void displayStudent() const {
        displayName();             // Calls base class function
        std::cout << "Roll Number: " << rollNumber << '\n';
    }
};

int main() {
    Student student("Amit", 101);  // Create Student object

    student.displayStudent();      // Display student details

    return 0;                      // End program
}

This is single inheritance because one derived class ("Student") inherits from one base class ("Person").
