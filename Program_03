#include <iostream>

class Base {
public:
    void show() const {
        std::cout << "Base public function\n";
    }
};

class PublicDerived : public Base {       // Public inheritance
};

class PrivateDerived : private Base {     // Private inheritance
public:
    void callBaseShow() const {
        show();                           // Accessible inside derived class
    }
};

int main() {
    PublicDerived publicObject;
    publicObject.show();                   // Public inheritance keeps show() public

    PrivateDerived privateObject;
    privateObject.callBaseShow();          // Access through public member function

    // privateObject.show();              // Error: show() becomes private

    return 0;                              // End of program
}

